# ----------------------------------------------------------------------
# FM-Stoerungen API — Environment Variables
# Copy this file to .env for local dev, or set as docker-compose env_file.
# Production secrets are managed via GitHub Secrets + deploy pipeline.
# ----------------------------------------------------------------------

ENV=dev
DEBUG=true
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fm_stoerungen

# JWT — Schicht 2 + 5: MUST be replaced in staging/prod (>= 32 chars random)
JWT_SECRET=dev-only-change-me-in-staging-and-prod-min-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS — list of allowed origins (comma-separated when using env file)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
